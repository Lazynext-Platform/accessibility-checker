import requests
from bs4 import BeautifulSoup
import re
from urllib.parse import urljoin, urlparse

class AccessibilityChecker:
    def __init__(self, url):
        self.url = url
        self.errors = []

    def scan(self):
        try:
            response = requests.get(self.url)
            soup = BeautifulSoup(response.text, 'html.parser')
            self.check_alt_tags(soup)
            self.check_link_text(soup)
            self.check_header_tags(soup)
            self.check_form_labels(soup)
            self.check_color_contrast(soup)
            return self.errors
        except Exception as e:
            self.errors.append(f"Error scanning website: {str(e)}")
            return self.errors

    def check_alt_tags(self, soup):
        images = soup.find_all('img')
        for image in images:
            if not image.get('alt'):
                self.errors.append(f"Missing alt tag for image: {image}")

    def check_link_text(self, soup):
        links = soup.find_all('a')
        for link in links:
            if not link.text.strip():
                self.errors.append(f"Link with empty text: {link}")

    def check_header_tags(self, soup):
        headers = soup.find_all(['h1', 'h2', 'h3', 'h4', 'h5', 'h6'])
        for header in headers:
            if not header.text.strip():
                self.errors.append(f"Empty header tag: {header}")

    def check_form_labels(self, soup):
        inputs = soup.find_all('input')
        for input in inputs:
            if not input.get('label'):
                self.errors.append(f"Missing label for input: {input}")

    def check_color_contrast(self, soup):
        # This is a simplified version of color contrast checking
        # In a real-world scenario, you would need to use a more sophisticated method
        styles = soup.find_all(style=re.compile('color'))
        for style in styles:
            color = re.search(r'color:\s*([^;]+)', style['style']).group(1)
            if not self.check_color_contrast_ratio(color):
                self.errors.append(f"Insufficient color contrast: {color}")

    def check_color_contrast_ratio(self, color):
        # This is a simplified version of color contrast ratio checking
        # In a real-world scenario, you would need to use a more sophisticated method
        if color == 'black' or color == 'white':
            return True
        else:
            return False

def scan_website(url):
    checker = AccessibilityChecker(url)
    return checker.scan()

def get_website_info(url):
    try:
        response = requests.get(url)
        soup = BeautifulSoup(response.text, 'html.parser')
        title = soup.find('title').text
        description = soup.find('meta', attrs={'name': 'description'})
        if description:
            description = description.get('content')
        else:
            description = ''
        return {
            'title': title,
            'description': description
        }
    except Exception as e:
        return {
            'error': str(e)
        }
