// Import required modules
const axios = require('axios');
const cheerio = require('cheerio');
const { URL } = require('url');

// Define constants
const WCAG_SUCCESS_CRITERIA = {
  A: 'A',
  AA: 'AA',
  AAA: 'AAA',
};

const WCAG_FAILURE_CRITERIA = {
  A: 'A',
  AA: 'AA',
  AAA: 'AAA',
};

// Define API endpoint for WCAG scans
async function scanWebsiteForWCAG(url) {
  try {
    // Send request to the website
    const response = await axios.get(url);

    // Check if the request was successful
    if (response.status !== 200) {
      throw new Error(`Failed to retrieve website. Status code: ${response.status}`);
    }

    // Parse HTML content using Cheerio
    const $ = cheerio.load(response.data);

    // Initialize object to store scan results
    const scanResults = {
      url,
      successCriteria: [],
      failureCriteria: [],
    };

    // Check for WCAG 2.1 success criteria
    // 1.1.1 Non-text Content: Provide alternative text for non-text content
    const imagesWithoutAltText = $('img:not([alt])');
    if (imagesWithoutAltText.length > 0) {
      scanResults.failureCriteria.push({
        criterion: '1.1.1',
        description: 'Non-text Content: Provide alternative text for non-text content',
        elements: imagesWithoutAltText.toArray(),
      });
    } else {
      scanResults.successCriteria.push('1.1.1');
    }

    // 1.4.3 Contrast (Minimum): Ensure sufficient contrast between text and background
    const elementsWithInsufficientContrast = [];
    $('*').each((index, element) => {
      const backgroundColor = $(element).css('background-color');
      const color = $(element).css('color');
      if (backgroundColor && color) {
        const contrastRatio = calculateContrastRatio(backgroundColor, color);
        if (contrastRatio < 4.5) {
          elementsWithInsufficientContrast.push(element);
        }
      }
    });
    if (elementsWithInsufficientContrast.length > 0) {
      scanResults.failureCriteria.push({
        criterion: '1.4.3',
        description: 'Contrast (Minimum): Ensure sufficient contrast between text and background',
        elements: elementsWithInsufficientContrast,
      });
    } else {
      scanResults.successCriteria.push('1.4.3');
    }

    // Check for WCAG 2.1 failure criteria
    // 2.4.3 Focus Order: Ensure that the focus order is logical and consistent
    const elementsWithIncorrectFocusOrder = [];
    const focusableElements = $('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    focusableElements.each((index, element) => {
      const tabIndex = $(element).attr('tabindex');
      if (tabIndex && tabIndex !== String(index + 1)) {
        elementsWithIncorrectFocusOrder.push(element);
      }
    });
    if (elementsWithIncorrectFocusOrder.length > 0) {
      scanResults.failureCriteria.push({
        criterion: '2.4.3',
        description: 'Focus Order: Ensure that the focus order is logical and consistent',
        elements: elementsWithIncorrectFocusOrder,
      });
    }

    // Return scan results
    return scanResults;
  } catch (error) {
    throw new Error(`Error scanning website for WCAG compliance: ${error.message}`);
  }
}

// Define function to calculate contrast ratio
function calculateContrastRatio(backgroundColor, color) {
  const backgroundColorRgb = hexToRgb(backgroundColor);
  const colorRgb = hexToRgb(color);
  const relativeLuminance1 = calculateRelativeLuminance(backgroundColorRgb);
  const relativeLuminance2 = calculateRelativeLuminance(colorRgb);
  const contrastRatio = (Math.max(relativeLuminance1, relativeLuminance2) + 0.05) / (Math.min(relativeLuminance1, relativeLuminance2) + 0.05);
  return contrastRatio;
}

// Define function to convert hex color to RGB
function hexToRgb(hex) {
  const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
  return result ? {
    r: parseInt(result[1], 16),
    g: parseInt(result[2], 16),
    b: parseInt(result[3], 16),
  } : null;
}

// Define function to calculate relative luminance
function calculateRelativeLuminance(rgb) {
  const r = rgb.r / 255;
  const g = rgb.g / 255;
  const b = rgb.b / 255;
  const rLinear = r <= 0.03928 ? r / 12.92 : Math.pow((r + 0.055) / 1.055, 2.4);
  const gLinear = g <= 0.03928 ? g / 12.92 : Math.pow((g + 0.055) / 1.055, 2.4);
  const bLinear = b <= 0.03928 ? b / 12.92 : Math.pow((b + 0.055) / 1.055, 2.4);
  return 0.2126 * rLinear + 0.7152 * gLinear + 0.0722 * bLinear;
}

// Export API endpoint
module.exports = {
  scanWebsiteForWCAG,
};
