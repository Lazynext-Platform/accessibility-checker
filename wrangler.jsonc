{
  // DO NOT `wrangler deploy` from this config — it drops the PLATFORM service
  // binding and PLATFORM_TOKEN secret (1101s + silent kvPut failures). Deploy
  // with `node scripts/deploy.mjs`, which sends the full bindings metadata.
  // This file exists only so `wrangler secret list/put`, `wrangler tail`, and
  // IDE tooling have a valid config to read.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accessibility-checker",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  }
}
